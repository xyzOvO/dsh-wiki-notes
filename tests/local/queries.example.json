{
  "version": "example",
  "library": "any",
  "note": "示例评测集。真跑的时候复制成 queries.json 再按自己的库改——queries.json 含真实笔记主题，所以不进仓库。expect 写「必须进前 5 的页名」，由人标，不依赖任何旧引擎。",
  "floor": {
    "recallAt5": 0.0,
    "mrrAt5": 0.0,
    "top1": 0.0
  },
  "queries": [
    { "q": "上下文 工程", "tags": ["多词"], "expect": ["上下文工程"] },
    { "q": "记忆系统", "tags": ["专名"], "expect": ["记忆系统"] },
    { "q": "RAG 和 长上下文 分歧", "tags": ["中英混写", "长句"], "expect": ["检索增强生成"] },
    { "q": "Agent Harness 是什么", "tags": ["长句"], "expect": ["Agent Harness"] },
    { "q": "ＭＣＰ", "tags": ["全角"], "expect": ["模型上下文协议"] },
    { "q": "评估基准有哪些", "tags": ["长句"], "expect": ["评估与基准"] }
  ]
}
